---
import '../styles/global.css';
import { url } from '../utils';

interface Props {
  title?: string;
  description?: string;
  /** 홈 화면처럼 상단 헤더 없이 페이지가 직접 레이아웃을 그릴 때 true */
  bare?: boolean;
}

const siteTitle = 'Neo Atelier';
const { title, description = 'Houdini FX 아티스트 HG의 1인 AI 스튜디오, Neo Atelier의 작업 기록', bare = false } = Astro.props;
const pageTitle = title ? `${title} | ${siteTitle}` : siteTitle;
const path = Astro.url.pathname;
const nav = [
  { href: url(''), label: '홈' },
  { href: url('archive/'), label: '전체 글' },
  { href: url('tags/'), label: '태그' },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  </head>
  <body class:list={{ bare }}>
    {
      bare ? (
        <slot />
      ) : (
        <Fragment>
          <header class="site-header">
            <div class="wrap header-inner">
              <a class="logo" href={url('')}><span class="logo-mark">▲</span> {siteTitle}</a>
              <nav>
                {nav.map((item) => (
                  <a href={item.href} aria-current={path === item.href || (item.href !== url('') && path.startsWith(item.href)) ? 'page' : undefined}>
                    {item.label}
                  </a>
                ))}
              </nav>
            </div>
          </header>
          <main class="wrap">
            <slot />
          </main>
          <footer class="site-footer wrap">
            <p>© {new Date().getFullYear()} HG · Neo Atelier</p>
          </footer>
        </Fragment>
      )
    }
  </body>
</html>
