---
import { formatDate, url, type Post } from '../utils';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

{posts.length === 0 && <p class="muted">아직 글이 없습니다.</p>}
<ul class="post-list">
  {
    posts.map((post) => (
      <li>
        <a class="post-card" href={url(`posts/${post.id}/`)}>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <h2>
            {post.data.title}
            {post.data.draft && <span class="badge">초안</span>}
            {post.data.youtube && <span class="badge video">영상</span>}
          </h2>
          {post.data.description && <p>{post.data.description}</p>}
        </a>
        {post.data.tags.length > 0 && (
          <div class="tags">
            {post.data.tags.map((tag) => (
              <a class="tag" href={url(`tags/${tag}/`)}>#{tag}</a>
            ))}
          </div>
        )}
      </li>
    ))
  }
</ul>
