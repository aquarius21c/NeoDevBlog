---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, url, type Post } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  <article class="post">
    <header class="post-header">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <h1>{post.data.title}</h1>
      {
        post.data.tags.length > 0 && (
          <div class="tags">
            {post.data.tags.map((tag) => (
              <a class="tag" href={url(`tags/${tag}/`)}>#{tag}</a>
            ))}
          </div>
        )
      }
    </header>
    {
      post.data.youtube && (
        <div class="video">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${post.data.youtube}`}
            title={`${post.data.title} 영상`}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          />
        </div>
      )
    }
    <div class="prose">
      <Content />
    </div>
  </article>
  <nav class="post-nav">
    {newer ? <a href={url(`posts/${newer.id}/`)}>← 다음 글<br /><strong>{newer.data.title}</strong></a> : <span />}
    {older ? <a class="older" href={url(`posts/${older.id}/`)}>이전 글 →<br /><strong>{older.data.title}</strong></a> : <span />}
  </nav>
</Base>
