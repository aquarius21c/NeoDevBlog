---
import { existsSync } from 'node:fs';
import Base from '../layouts/Base.astro';
import '../styles/home.css';
import NodeGraph from '../components/NodeGraph.astro';
import { formatDate, getPosts, url } from '../utils';
import { contacts, experience, profile, projects, reel } from '../data/profile';

const posts = await getPosts();
const isExternal = (link: string) => /^https?:\/\//.test(link);
// 아직 올라오지 않은 글이나 문서로는 링크를 걸지 않습니다.
const postIds = new Set(posts.map((p) => p.id));
const linkReady = (link: string) =>
  isExternal(link) ||
  (link.startsWith('posts/') ? postIds.has(link.slice(6).replace(/\/$/, '')) : existsSync(`public/${link}`));
const icons: Record<string, string> = {
  video: 'M4 5h11a1 1 0 0 1 1 1v3l4-2.5v11L16 15v3a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z',
  clock: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm0 4v5l3.5 2',
  team: 'M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm-6 9c0-3.3 2.7-6 6-6s6 2.7 6 6M16 4.5a3.5 3.5 0 0 1 0 6.5M21 20c0-2.7-1.6-5-4-5.7',
  stage: 'M3 7h4v10H3zM10 7h4v10h-4zM17 7h4v10h-4z',
};
const recent = posts.slice(0, 5);
const sections = [
  { id: 'about', label: 'ABOUT' },
  { id: 'experience', label: 'EXPERIENCE' },
  { id: 'projects', label: 'PROJECTS' },
  { id: 'writing', label: 'WRITING' },
];
---

<Base bare>
  <div class="spotlight" aria-hidden="true"></div>
  <div class="home">
    <header class="intro">
      <div>
        <div class="brand">
          <span class="brand-bar" aria-hidden="true"></span>
          <h1><a href={url('')} aria-label={profile.name}>Neo<span class="dot">.</span>Atelier</a></h1>
          <p class="keywords">{profile.keywords}</p>
          <NodeGraph class="node-graph" />
        </div>
        <p class="person"><span>{profile.nameEn}</span><span lang="ko">{profile.nameKo}</span></p>
        <p class="role">{profile.role}</p>
        <p class="tagline">{profile.tagline}</p>
        <nav class="section-nav" aria-label="홈 섹션">
          <ul>
            {sections.map((s) => (
              <li><a href={`#${s.id}`} data-section={s.id}><span class="line"></span>{s.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
      <ul class="contacts" aria-label="연락처">
        {contacts.email && (
          <li>
            <a href={`mailto:${contacts.email}`} title={contacts.email} aria-label={`이메일 ${contacts.email}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18v12H3zM3 7l9 6 9-6" /></svg>
              <span>{contacts.email}</span>
            </a>
          </li>
        )}
        {contacts.linkedin && (
          <li>
            <a href={contacts.linkedin} rel="noopener" target="_blank" title="LinkedIn" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h3v11H4zM5.5 4.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3ZM10 9h3v1.6c.6-1 1.8-1.8 3.4-1.8 2.6 0 3.6 1.7 3.6 4.4V20h-3v-6.2c0-1.4-.5-2.3-1.8-2.3s-2.2 1-2.2 2.5V20h-3z" /></svg>
              <span>LinkedIn</span>
            </a>
          </li>
        )}
      </ul>
    </header>

    <main class="content">
      <section id="about" aria-label="소개">
        <h2 class="section-title">About</h2>
        <p>
          안녕하세요, <strong>{profile.nameKo}</strong>입니다. 국내와 할리우드 작품을 포함해 10년 넘게
          <strong>영화 VFX</strong>에서 폭발, 연기, 파편 같은 FX를 만들어 왔습니다.
        </p>
        <p>
          AI를 공부하면서 역할이 다른 AI 에이전트들에게 일을 나눠 맡기는 <strong>에이전트 하네스</strong>를 배웠고,
          이 방식으로 혼자서도 스튜디오처럼 일하는 <strong>Neo Atelier</strong>를 시작했습니다. 저는 방향과 결정,
          품질 판단을 맡고, AI는 그 결정을 빠르게 실행합니다.
        </p>
        <p>
          지금은 이 구조로 언리얼 엔진 슈터 게임 <strong>UrbanStrike</strong>를 만들고 있고, 만드는 과정은 이 블로그와
          유튜브에 기록하고 있습니다.
        </p>
        <figure class="reel">
          <div class="reel-frame">
            <iframe
              src={`https://player.vimeo.com/video/${reel.vimeoId}?dnt=1&title=0&byline=0&portrait=0`}
              title={reel.title}
              loading="lazy"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
          <figcaption>
            <a href={`https://vimeo.com/${reel.vimeoId}`} rel="noopener" target="_blank">{reel.title} <span aria-hidden="true">↗</span></a>
            <span>{reel.caption}</span>
          </figcaption>
        </figure>
      </section>

      <section id="experience" aria-label="경력">
        <h2 class="section-title">Experience</h2>
        <ol class="cards">
          {experience.map((item) => (
            <li class="card">
              <p class="card-meta">{item.period}</p>
              <div>
                <h3>{item.title}</h3>
                <p>{item.summary}</p>
                <ul class="chips">{item.tags.map((t) => <li>{t}</li>)}</ul>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section id="projects" aria-label="프로젝트">
        <h2 class="section-title">Projects</h2>
        <ul class="cards">
          {projects.map((p) => (
            <li class="card">
              <img src={url(p.image)} alt={p.imageAlt} width="640" height="360" loading="lazy" />
              <div>
                <h3>
                  {linkReady(p.link) ? (
                    <a
                      class="card-link"
                      href={isExternal(p.link) ? p.link : url(p.link)}
                      {...(isExternal(p.link) ? { target: '_blank', rel: 'noopener' } : {})}
                    >
                      {p.title} <span aria-hidden="true">↗</span>
                    </a>
                  ) : (
                    p.title
                  )}
                </h3>
                <p>{p.summary}</p>
                {p.stats.length > 0 && (
                  <ul class="stats">
                    {p.stats.map((st) => (
                      <li>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons[st.icon]} /></svg>
                        {st.label}
                      </li>
                    ))}
                  </ul>
                )}
                <ul class="chips">{p.tags.map((t) => <li>{t}</li>)}</ul>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section id="writing" aria-label="글">
        <h2 class="section-title">Writing</h2>
        {recent.length === 0 && <p class="muted">아직 글이 없습니다.</p>}
        <ul class="cards">
          {recent.map((post) => (
            <li class="card">
              <p class="card-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></p>
              <div>
                <h3>
                  <a class="card-link" href={url(`posts/${post.id}/`)}>{post.data.title}</a>
                  {post.data.draft && <span class="badge">초안</span>}
                  {post.data.youtube && <span class="badge video">영상</span>}
                </h3>
                {post.data.description && <p>{post.data.description}</p>}
                {post.data.tags.length > 0 && (
                  <ul class="chips">{post.data.tags.map((tag) => <li><a href={url(`tags/${tag}/`)}>#{tag}</a></li>)}</ul>
                )}
              </div>
            </li>
          ))}
        </ul>
        <p class="more"><a href={url('archive/')}>전체 글 보기 <span aria-hidden="true">→</span></a></p>
      </section>

      <footer class="home-footer">
        <p>© {new Date().getFullYear()} HG · Neo Atelier. Astro로 만들고 GitHub Pages로 배포합니다.</p>
      </footer>
    </main>
  </div>

  <script>
    // 마우스를 따라다니는 은은한 조명과, 현재 보고 있는 섹션을 왼쪽 메뉴에 표시합니다.
    const spotlight = document.querySelector<HTMLElement>('.spotlight');
    if (spotlight && matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      window.addEventListener('pointermove', (e) => {
        spotlight.style.setProperty('--x', `${e.clientX}px`);
        spotlight.style.setProperty('--y', `${e.clientY}px`);
        spotlight.classList.add('on');
      });
    }

    const links = new Map(
      [...document.querySelectorAll<HTMLAnchorElement>('.section-nav a')].map((a) => [a.dataset.section, a]),
    );
    // 화면 위쪽 40% 지점을 지난 마지막 섹션을 현재 섹션으로 봅니다.
    const sections = [...document.querySelectorAll<HTMLElement>('.content section')];
    const markCurrent = () => {
      const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
      const current = atBottom
        ? sections[sections.length - 1]
        : sections.filter((s) => s.getBoundingClientRect().top <= innerHeight * 0.4).pop();
      links.forEach((a, id) => (id === current?.id ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
    };
    addEventListener('scroll', markCurrent, { passive: true });
    markCurrent();
  </script>
</Base>
